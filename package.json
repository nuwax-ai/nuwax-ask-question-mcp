{
  "name": "nuwax-ask-question-mcp",
  "version": "0.1.0",
  "description": "MCP ask/question server for Nuwax conversation interaction cards.",
  "type": "module",
  "bin": {
    "nuwax-ask-question-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_PATH=/Users/apple/workspace/nuwaclaw/crates/agent-electron-client/node_modules /Users/apple/workspace/nuwaclaw/crates/agent-electron-client/node_modules/.bin/vitest run",
    "test:watch": "NODE_PATH=/Users/apple/workspace/nuwaclaw/crates/agent-electron-client/node_modules /Users/apple/workspace/nuwaclaw/crates/agent-electron-client/node_modules/.bin/vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nuwax",
    "ask",
    "question"
  ],
  "author": "Nuwax Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
