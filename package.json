{
  "name": "nuwax-ask-question-mcp",
  "version": "4.0.2",
  "description": "MCP ask/question server for Nuwax conversation interaction cards.",
  "type": "module",
  "bin": {
    "nuwax-ask-question-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./ask-user-payload": "./dist/askUserPayload.js",
    "./build-raw-input": "./dist/buildRawInput.js",
    "./widgets": "./dist/widgets.js",
    "./schemas/schema.json": "./schemas/schema.json",
    "./schemas/examples/complete-form.json": "./schemas/examples/complete-form.json"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build:lib": "tsc -p tsconfig.json",
    "build:bundle": "node scripts/bundle.mjs",
    "build": "npm run clean && npm run build:lib && npm run build:bundle",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "dump:input-schema": "tsx scripts/dump-input-schema.ts",
    "test": "vitest run && node scripts/verify-widget-contract.mjs",
    "test:watch": "vitest",
    "verify:widgets": "node scripts/verify-widget-contract.mjs",
    "prepublishOnly": "npm test && npm run build",
    "sync:npmmirror": "node scripts/sync-npmmirror.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nuwax",
    "ask",
    "question"
  ],
  "author": "Nuwax Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuwax-ai/nuwax-ask-question-mcp.git"
  },
  "homepage": "https://github.com/nuwax-ai/nuwax-ask-question-mcp#readme",
  "bugs": {
    "url": "https://github.com/nuwax-ai/nuwax-ask-question-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "zod-to-json-schema": "^3.25.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.2.2"
}
