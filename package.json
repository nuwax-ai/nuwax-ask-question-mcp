{
  "name": "nuwax-ask-question-mcp",
  "version": "3.1.0",
  "description": "MCP ask/question server for Nuwax conversation interaction cards.",
  "type": "module",
  "bin": {
    "nuwax-ask-question-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build",
    "sync:npmmirror": "node scripts/sync-npmmirror.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nuwax",
    "ask",
    "question"
  ],
  "author": "Nuwax Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuwax-ai/nuwax-ask-question-mcp.git"
  },
  "homepage": "https://github.com/nuwax-ai/nuwax-ask-question-mcp#readme",
  "bugs": {
    "url": "https://github.com/nuwax-ai/nuwax-ask-question-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
