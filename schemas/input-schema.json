{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "nuwax.mcp_ask.v2",
      "default": "nuwax.mcp_ask.v2",
      "description": "【请勿输出本字段】MCP 契约版本，由服务端自动盖戳为 nuwax.mcp_ask.v2。省略即可。"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "description": "请求唯一标识；用户响应中原样回传，用于关联问答"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "default": 1,
      "description": "提问修订号，从 1 开始；后续修订递增。新提问省略即可（默认 1）。"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "description": "会话 ID"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "本次提问标题，显示在卡片顶部"
    },
    "description": {
      "type": "string",
      "description": "本次提问补充说明"
    },
    "ui": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "nuwax.interaction.v2",
          "default": "nuwax.interaction.v2",
          "description": "【请勿输出本字段】UI 契约版本，由服务端自动盖戳为 nuwax.interaction.v2。省略即可。"
        },
        "presentation": {
          "type": "string",
          "enum": [
            "modal",
            "inline",
            "wizard"
          ],
          "description": "展示方式：inline（行内，最常用）/ modal（弹窗）/ wizard（分步）"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "卡片内表单标题"
        },
        "description": {
          "type": "string",
          "description": "卡片内表单说明"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "字段名（formData 的 key，全表单内唯一；wizard steps.fields 引用此 name）"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "展示标签（antd Form.Item label）"
              },
              "widget": {
                "type": "string",
                "enum": [
                  "text",
                  "textarea",
                  "number",
                  "radio",
                  "checkboxes",
                  "select",
                  "list",
                  "file",
                  "radio-with-custom"
                ],
                "description": "控件类型"
              },
              "description": {
                "type": "string",
                "description": "字段帮助文案（tooltip/help）"
              },
              "required": {
                "type": "boolean",
                "description": "是否必填，默认 false"
              },
              "placeholder": {
                "type": "string",
                "description": "占位提示"
              },
              "initialValue": {
                "description": "字段初始值（旧 ui.initialValue[name] 下沉到字段）"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "array"
                ],
                "description": "值类型，缺省按 widget 推断：number→number/integer、checkboxes→array、其余→string"
              },
              "minimum": {
                "type": "number",
                "description": "最小值（widget=number）"
              },
              "maximum": {
                "type": "number",
                "description": "最大值（widget=number）"
              },
              "exclusiveMinimum": {
                "type": "number",
                "description": "严格大于（widget=number）"
              },
              "exclusiveMaximum": {
                "type": "number",
                "description": "严格小于（widget=number）"
              },
              "multipleOf": {
                "type": "number",
                "description": "倍数约束（widget=number）"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "description": "最小长度（widget=text/textarea）"
              },
              "maxLength": {
                "type": "integer",
                "minimum": 0,
                "description": "最大长度（widget=text/textarea）"
              },
              "pattern": {
                "type": "string",
                "description": "正则约束（widget=text）"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "description": "选项值，进入 formData"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "description": "选项展示文案（人类可读）"
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "description": "选择类控件（radio/select/list/checkboxes/radio-with-custom）的选项数组 [{value,label}]"
              },
              "accept": {
                "type": "string",
                "description": "MIME 过滤器，如 image/*（widget=file）"
              },
              "multiple": {
                "type": "boolean",
                "description": "是否允许多文件（widget=file）"
              },
              "maxFileSize": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "单文件最大字节数（widget=file）"
              },
              "allowCustom": {
                "type": "boolean",
                "description": "是否允许自定义选项（widget=radio-with-custom）"
              },
              "otherValue": {
                "type": "string",
                "description": "自定义选项的值，默认 __custom__（widget=radio-with-custom）"
              },
              "otherField": {
                "type": "string",
                "description": "自定义输入框字段名，默认 {name}Custom（widget=radio-with-custom）"
              }
            },
            "required": [
              "name",
              "title",
              "widget"
            ],
            "additionalProperties": false
          },
          "description": "表单字段（有序数组）；数组顺序即展示顺序。inline/modal/wizard 必填"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "步骤唯一标识"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "步骤标题"
              },
              "description": {
                "type": "string",
                "description": "步骤说明"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "引用 ui.fields 中某字段的 name"
                },
                "minItems": 1,
                "description": "本步展示的字段 name 数组，引用 ui.fields 中字段的 name"
              }
            },
            "required": [
              "id",
              "title",
              "fields"
            ],
            "additionalProperties": false,
            "description": "wizard 的单个步骤"
          },
          "description": "wizard 分步配置；仅 presentation=wizard 时使用"
        },
        "submitLabel": {
          "type": "string",
          "description": "提交按钮文案"
        },
        "cancelLabel": {
          "type": "string",
          "description": "取消按钮文案"
        },
        "fallback": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "降级文案"
            },
            "webUrl": {
              "type": "string",
              "format": "uri",
              "description": "Web 降级链接"
            },
            "mobileUrl": {
              "type": "string",
              "format": "uri",
              "description": "Mobile 降级链接"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "description": "客户端无法渲染卡片时的降级方案"
        }
      },
      "required": [
        "presentation",
        "title"
      ],
      "additionalProperties": true
    },
    "business": {
      "type": "object",
      "additionalProperties": {},
      "description": "业务透传数据，原样存入 rawInput，不影响渲染"
    },
    "timeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "超时毫秒数；超时后动作记为 timeout"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "high"
      ],
      "description": "优先级：normal（默认）/ high（高优先级，可能强提醒）"
    }
  },
  "required": [
    "requestId",
    "sessionId",
    "title",
    "ui"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
