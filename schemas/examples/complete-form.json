{
  "toolName": "nuwax_ask_question",
  "schemaVersion": "nuwax.mcp_ask.v2",
  "requestId": "ask_demo_001",
  "revision": 1,
  "sessionId": "session_demo",
  "title": "请确认继续方式",
  "description": "Agent 需要你的决定才能继续。",
  "ui": {
    "version": "nuwax.interaction.v2",
    "presentation": "inline",
    "title": "请确认继续方式",
    "fields": [
      {
        "name": "choice",
        "title": "继续方式",
        "widget": "radio",
        "required": true,
        "options": [
          { "value": "test", "label": "先跑测试" },
          { "value": "deploy", "label": "直接部署" }
        ]
      },
      {
        "name": "remark",
        "title": "补充说明",
        "widget": "textarea"
      },
      {
        "name": "checks",
        "title": "检查项",
        "widget": "checkboxes",
        "type": "array",
        "options": [
          { "value": "lint", "label": "代码检查" },
          { "value": "unit", "label": "单元测试" }
        ]
      },
      {
        "name": "count",
        "title": "并发数",
        "widget": "number",
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      }
    ],
    "submitLabel": "提交",
    "cancelLabel": "取消"
  },
  "timeoutMs": 1800000
}
