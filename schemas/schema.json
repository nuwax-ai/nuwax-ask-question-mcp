{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.nuwax.ai/nuwax-ask-question/v1/schema.json",
  "title": "Nuwax Ask Question Protocol",
  "description": "统一契约（v2）：MCP 工具 nuwax_ask_question 入参、UI 渲染、控件类型与客户端回执。表单以 ui.fields（有序字段数组）表达，控件/选项/约束合并进单字段；后端可据此生成 rawInput，Web/Mobile DockPanel 可直接渲染。",
  "version": "2.0.0",
  "$comment": "HAND-MAINTAINED: 此文件由 scripts/generate-schema.ts 部分自动生成。顶层 $comment / $schema / $id / title / description / version 为手写区域；$defs 中 WidgetType / WidgetCatalog / DeprecatedBuilderAliases / WidgetInferenceRules / NuwaxAskQuestionInput / InteractionUi 及 x-nuwax 的 protocolVersion / constants / transport / widgetTypes 等字段由 generate:schema 脚本覆写，勿手动编辑这些区域。",
  "$defs": {
    "InteractionUiSchemaVersion": {
      "type": "string",
      "const": "nuwax.interaction.v2",
      "description": "交互 UI 契约版本（v2：字段数组 fields[]）"
    },
    "McpAskToolName": {
      "type": "string",
      "const": "nuwax_ask_question",
      "description": "MCP 工具名，与 ACP tool_call.rawInput.toolName 一致"
    },
    "Priority": {
      "type": "string",
      "enum": [
        "normal",
        "high"
      ]
    },
    "WidgetType": {
      "type": "string",
      "enum": [
        "text",
        "textarea",
        "number",
        "radio",
        "checkboxes",
        "select",
        "list",
        "file",
        "radio-with-custom"
      ],
      "description": "字段控件类型（widget）。v2 起作为字段必填属性；Builder 层 field.type 应使用相同值"
    },
    "McpAskRespondAction": {
      "type": "string",
      "enum": [
        "submit",
        "cancel",
        "skip",
        "timeout"
      ],
      "description": "用户响应动作"
    },
    "McpAskResponseStatus": {
      "type": "string",
      "enum": [
        "pending",
        "submitting",
        "submitted",
        "cancelled",
        "skipped",
        "failed"
      ]
    },
    "WizardStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "Fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "webUrl": {
          "type": "string",
          "format": "uri"
        },
        "mobileUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "InteractionUi": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "nuwax.interaction.v2",
          "description": "UI 契约版本（nuwax.interaction.v2）"
        },
        "presentation": {
          "type": "string",
          "enum": [
            "modal",
            "inline",
            "wizard"
          ],
          "description": "展示方式：inline（行内，最常用）/ modal（弹窗）/ wizard（分步）"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "卡片内表单标题"
        },
        "description": {
          "type": "string",
          "description": "卡片内表单说明"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "字段名（formData 的 key，全表单内唯一；wizard steps.fields 引用此 name）"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "展示标签（antd Form.Item label）"
              },
              "widget": {
                "type": "string",
                "enum": [
                  "text",
                  "textarea",
                  "number",
                  "radio",
                  "checkboxes",
                  "select",
                  "list",
                  "file",
                  "radio-with-custom"
                ],
                "description": "控件类型"
              },
              "description": {
                "type": "string",
                "description": "字段帮助文案（tooltip/help）"
              },
              "required": {
                "type": "boolean",
                "description": "是否必填，默认 false"
              },
              "placeholder": {
                "type": "string",
                "description": "占位提示"
              },
              "initialValue": {
                "description": "字段初始值（旧 ui.initialValue[name] 下沉到字段）"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "array"
                ],
                "description": "值类型，缺省按 widget 推断：number→number/integer、checkboxes→array、其余→string"
              },
              "minimum": {
                "type": "number",
                "description": "最小值（widget=number）"
              },
              "maximum": {
                "type": "number",
                "description": "最大值（widget=number）"
              },
              "exclusiveMinimum": {
                "type": "number",
                "description": "严格大于（widget=number）"
              },
              "exclusiveMaximum": {
                "type": "number",
                "description": "严格小于（widget=number）"
              },
              "multipleOf": {
                "type": "number",
                "description": "倍数约束（widget=number）"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "description": "最小长度（widget=text/textarea）"
              },
              "maxLength": {
                "type": "integer",
                "minimum": 0,
                "description": "最大长度（widget=text/textarea）"
              },
              "pattern": {
                "type": "string",
                "description": "正则约束（widget=text）"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "description": "选项值，进入 formData"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "description": "选项展示文案（人类可读）"
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "description": "选择类控件（radio/select/list/checkboxes/radio-with-custom）的选项数组 [{value,label}]"
              },
              "accept": {
                "type": "string",
                "description": "MIME 过滤器，如 image/*（widget=file）"
              },
              "multiple": {
                "type": "boolean",
                "description": "是否允许多文件（widget=file）"
              },
              "maxFileSize": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "单文件最大字节数（widget=file）"
              },
              "allowCustom": {
                "type": "boolean",
                "description": "是否允许自定义选项（widget=radio-with-custom）"
              },
              "otherValue": {
                "type": "string",
                "description": "自定义选项的值，默认 __custom__（widget=radio-with-custom）"
              },
              "otherField": {
                "type": "string",
                "description": "自定义输入框字段名，默认 {name}Custom（widget=radio-with-custom）"
              }
            },
            "required": [
              "name",
              "title",
              "widget"
            ],
            "additionalProperties": false
          },
          "description": "表单字段（有序数组）；数组顺序即展示顺序。inline/modal/wizard 必填"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "步骤唯一标识"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "步骤标题"
              },
              "description": {
                "type": "string",
                "description": "步骤说明"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "引用 ui.fields 中某字段的 name"
                },
                "minItems": 1,
                "description": "本步展示的字段 name 数组，引用 ui.fields 中字段的 name"
              }
            },
            "required": [
              "id",
              "title",
              "fields"
            ],
            "additionalProperties": false,
            "description": "wizard 的单个步骤"
          },
          "description": "wizard 分步配置；仅 presentation=wizard 时使用"
        },
        "submitLabel": {
          "type": "string",
          "description": "提交按钮文案"
        },
        "cancelLabel": {
          "type": "string",
          "description": "取消按钮文案"
        },
        "allowSkip": {
          "type": "boolean",
          "description": "是否允许跳过(显示「跳过」按钮,跳过即放弃本次回答)"
        },
        "skipLabel": {
          "type": "string",
          "description": "跳过按钮文案(allowSkip=true 时显示)"
        },
        "fallback": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "降级文案"
            },
            "webUrl": {
              "type": "string",
              "format": "uri",
              "description": "Web 降级链接"
            },
            "mobileUrl": {
              "type": "string",
              "format": "uri",
              "description": "Mobile 降级链接"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "description": "客户端无法渲染卡片时的降级方案"
        }
      },
      "required": [
        "version",
        "presentation",
        "title"
      ],
      "additionalProperties": true,
      "description": "交互 UI 定义；DockPanel / McpAskQuestionCard 直接消费"
    },
    "NuwaxAskQuestionInput": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "nuwax.mcp_ask.v2",
          "description": "MCP 契约版本（nuwax.mcp_ask.v2）"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "description": "请求唯一标识；用户响应中原样回传，用于关联问答"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "提问修订号，从 1 开始；后续修订递增"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "description": "会话 ID"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "本次提问标题，显示在卡片顶部"
        },
        "description": {
          "type": "string",
          "description": "本次提问补充说明"
        },
        "ui": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "nuwax.interaction.v2",
              "description": "UI 契约版本（nuwax.interaction.v2）"
            },
            "presentation": {
              "type": "string",
              "enum": [
                "modal",
                "inline",
                "wizard"
              ],
              "description": "展示方式：inline（行内，最常用）/ modal（弹窗）/ wizard（分步）"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "卡片内表单标题"
            },
            "description": {
              "type": "string",
              "description": "卡片内表单说明"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "字段名（formData 的 key，全表单内唯一；wizard steps.fields 引用此 name）"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "description": "展示标签（antd Form.Item label）"
                  },
                  "widget": {
                    "type": "string",
                    "enum": [
                      "text",
                      "textarea",
                      "number",
                      "radio",
                      "checkboxes",
                      "select",
                      "list",
                      "file",
                      "radio-with-custom"
                    ],
                    "description": "控件类型"
                  },
                  "description": {
                    "type": "string",
                    "description": "字段帮助文案（tooltip/help）"
                  },
                  "required": {
                    "type": "boolean",
                    "description": "是否必填，默认 false"
                  },
                  "placeholder": {
                    "type": "string",
                    "description": "占位提示"
                  },
                  "initialValue": {
                    "description": "字段初始值（旧 ui.initialValue[name] 下沉到字段）"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "string",
                      "integer",
                      "number",
                      "array"
                    ],
                    "description": "值类型，缺省按 widget 推断：number→number/integer、checkboxes→array、其余→string"
                  },
                  "minimum": {
                    "type": "number",
                    "description": "最小值（widget=number）"
                  },
                  "maximum": {
                    "type": "number",
                    "description": "最大值（widget=number）"
                  },
                  "exclusiveMinimum": {
                    "type": "number",
                    "description": "严格大于（widget=number）"
                  },
                  "exclusiveMaximum": {
                    "type": "number",
                    "description": "严格小于（widget=number）"
                  },
                  "multipleOf": {
                    "type": "number",
                    "description": "倍数约束（widget=number）"
                  },
                  "minLength": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "最小长度（widget=text/textarea）"
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "最大长度（widget=text/textarea）"
                  },
                  "pattern": {
                    "type": "string",
                    "description": "正则约束（widget=text）"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "description": "选项值，进入 formData"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "description": "选项展示文案（人类可读）"
                        }
                      },
                      "required": [
                        "value",
                        "label"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "description": "选择类控件（radio/select/list/checkboxes/radio-with-custom）的选项数组 [{value,label}]"
                  },
                  "accept": {
                    "type": "string",
                    "description": "MIME 过滤器，如 image/*（widget=file）"
                  },
                  "multiple": {
                    "type": "boolean",
                    "description": "是否允许多文件（widget=file）"
                  },
                  "maxFileSize": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "description": "单文件最大字节数（widget=file）"
                  },
                  "allowCustom": {
                    "type": "boolean",
                    "description": "是否允许自定义选项（widget=radio-with-custom）"
                  },
                  "otherValue": {
                    "type": "string",
                    "description": "自定义选项的值，默认 __custom__（widget=radio-with-custom）"
                  },
                  "otherField": {
                    "type": "string",
                    "description": "自定义输入框字段名，默认 {name}Custom（widget=radio-with-custom）"
                  }
                },
                "required": [
                  "name",
                  "title",
                  "widget"
                ],
                "additionalProperties": false
              },
              "description": "表单字段（有序数组）；数组顺序即展示顺序。inline/modal/wizard 必填"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "步骤唯一标识"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "description": "步骤标题"
                  },
                  "description": {
                    "type": "string",
                    "description": "步骤说明"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "description": "引用 ui.fields 中某字段的 name"
                    },
                    "minItems": 1,
                    "description": "本步展示的字段 name 数组，引用 ui.fields 中字段的 name"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "fields"
                ],
                "additionalProperties": false,
                "description": "wizard 的单个步骤"
              },
              "description": "wizard 分步配置；仅 presentation=wizard 时使用"
            },
            "submitLabel": {
              "type": "string",
              "description": "提交按钮文案"
            },
            "cancelLabel": {
              "type": "string",
              "description": "取消按钮文案"
            },
            "allowSkip": {
              "type": "boolean",
              "description": "是否允许跳过(显示「跳过」按钮,跳过即放弃本次回答)"
            },
            "skipLabel": {
              "type": "string",
              "description": "跳过按钮文案(allowSkip=true 时显示)"
            },
            "fallback": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "降级文案"
                },
                "webUrl": {
                  "type": "string",
                  "format": "uri",
                  "description": "Web 降级链接"
                },
                "mobileUrl": {
                  "type": "string",
                  "format": "uri",
                  "description": "Mobile 降级链接"
                }
              },
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "description": "客户端无法渲染卡片时的降级方案"
            }
          },
          "required": [
            "version",
            "presentation",
            "title"
          ],
          "additionalProperties": true,
          "description": "交互 UI 定义（表单字段 + 展示/降级配置）"
        },
        "business": {
          "type": "object",
          "additionalProperties": {},
          "description": "业务透传数据，原样存入 rawInput，不影响渲染"
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "超时毫秒数；超时后动作记为 timeout"
        },
        "priority": {
          "type": "string",
          "enum": [
            "normal",
            "high"
          ],
          "description": "优先级：normal（默认）/ high（高优先级，可能强提醒）"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "revision",
        "sessionId",
        "title",
        "ui"
      ],
      "additionalProperties": false,
      "title": "MCP Tool Input",
      "description": "nuwax_ask_question 工具入参（不含 toolName）"
    },
    "McpAskUserToolInput": {
      "allOf": [
        {
          "$ref": "#/$defs/NuwaxAskQuestionInput"
        },
        {
          "type": "object",
          "required": [
            "toolName"
          ],
          "properties": {
            "toolName": {
              "$ref": "#/$defs/McpAskToolName"
            }
          }
        }
      ],
      "title": "ACP rawInput",
      "description": "tool_call.rawInput 完整形态；后端生成此结构即可驱动 DockPanel"
    },
    "NuwaxAskQuestionOutput": {
      "type": "object",
      "title": "MCP Tool Output",
      "description": "工具 structuredContent 返回值",
      "additionalProperties": false,
      "required": [
        "status",
        "requestId",
        "revision",
        "message",
        "input"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "pending",
          "description": "Agent 收到后立即停止当前轮次"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "message": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/McpAskUserToolInput",
          "description": "经 MCP Server 规范化后的完整 rawInput；平台应优先用此字段驱动 DockPanel，而非 agent 原始 tool 参数"
        }
      }
    },
    "McpAskRespondPayload": {
      "type": "object",
      "title": "Client Respond Payload",
      "description": "Web/Mobile 用户提交后内部 payload（非 MCP 协议层）",
      "additionalProperties": false,
      "required": [
        "interventionId",
        "revision",
        "source",
        "protocol",
        "action"
      ],
      "properties": {
        "interventionId": {
          "type": "string",
          "minLength": 1,
          "description": "等于 input.requestId"
        },
        "toolCallId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "source": {
          "const": "mcp_ask"
        },
        "protocol": {
          "const": "mcp"
        },
        "action": {
          "$ref": "#/$defs/McpAskRespondAction"
        },
        "formData": {
          "type": "object",
          "additionalProperties": true,
          "description": "用户填写的表单值"
        },
        "answeredBy": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "web",
                "mobile"
              ]
            },
            "userId": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "answeredAt": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
    "WidgetCatalogEntry": {
      "type": "object",
      "description": "Builder 控件目录项；entry.type 与 field.widget 使用相同命名",
      "required": [
        "type",
        "label",
        "field"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/WidgetType"
        },
        "label": {
          "type": "string",
          "description": "Builder 中文展示名"
        },
        "field": {
          "type": "object",
          "description": "v2 字段模板示例（控件/选项/约束合并为单字段对象）",
          "required": [
            "widget"
          ],
          "properties": {
            "widget": {
              "$ref": "#/$defs/WidgetType"
            }
          },
          "additionalProperties": true
        },
        "autoInfer": {
          "type": "boolean",
          "description": "省略 widget 时是否可自动推断"
        },
        "clientSupport": {
          "type": "string",
          "enum": [
            "supported",
            "planned"
          ],
          "description": "nuwax Web DockPanel 渲染支持状态"
        }
      }
    },
    "WidgetCatalog": {
      "type": "array",
      "description": "v1 正式控件目录",
      "items": {
        "$ref": "#/$defs/WidgetCatalogEntry"
      }
    },
    "WidgetInferenceRules": {
      "type": "array",
      "description": "v2 推荐 widget 必填；省略时按下列规则推断控件（格式定义，具体规则见 widgets.ts）",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "string"
          },
          "widget": {
            "$ref": "#/$defs/WidgetType"
          }
        },
        "required": [
          "when",
          "widget"
        ],
        "additionalProperties": false
      }
    },
    "DeprecatedBuilderAliases": {
      "type": "object",
      "description": "已废弃的 Builder 别名，生成 rawInput 时必须映射",
      "additionalProperties": false,
      "properties": {
        "input": {
          "const": "text"
        },
        "checkbox": {
          "const": "checkboxes"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/McpAskUserToolInput",
      "title": "rawInput",
      "description": "后端 → SSE/tool_call → DockPanel（推荐入口）"
    },
    {
      "$ref": "#/$defs/NuwaxAskQuestionInput",
      "title": "mcpToolInput",
      "description": "MCP 工具调用入参"
    },
    {
      "$ref": "#/$defs/NuwaxAskQuestionOutput",
      "title": "mcpToolOutput",
      "description": "MCP 工具返回"
    },
    {
      "$ref": "#/$defs/McpAskRespondPayload",
      "title": "clientRespond",
      "description": "客户端用户响应"
    }
  ],
  "x-nuwax": {
    "protocolVersion": "2.0.0",
    "constants": {
      "schemaVersion": "nuwax.mcp_ask.v2",
      "uiVersion": "nuwax.interaction.v2",
      "toolName": "nuwax_ask_question",
      "pendingStatus": "pending",
      "transport": "stdio"
    },
    "primaryEntry": "McpAskUserToolInput",
    "widgetCatalog": {
      "$ref": "#/$defs/WidgetCatalog"
    },
    "widgetInferenceRules": {
      "$ref": "#/$defs/WidgetInferenceRules"
    },
    "deprecatedBuilderAliases": {
      "$ref": "#/$defs/DeprecatedBuilderAliases"
    },
    "completeFormExample": "schemas/examples/complete-form.json",
    "renderPipeline": [
      "rawInput",
      "parseMcpAskToolInput",
      "mcpAskInteractions",
      "DockPanel",
      "McpAskQuestionCard",
      "parseInteractionFields",
      "McpAskFormField"
    ],
    "widgetTypes": [
      "text",
      "textarea",
      "number",
      "radio",
      "checkboxes",
      "select",
      "list",
      "file",
      "radio-with-custom"
    ],
    "transport": "stdio",
    "transportNote": "MCP Host 以子进程 stdio 拉起本包；用户表单由 nuwax Web/Mobile 渲染，不经本进程 HTTP"
  }
}
